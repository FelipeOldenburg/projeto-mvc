<%- include ('partials/header') %>

<main class="shell narrow">
    <section class="page-head">
        <span class="eyebrow">Edicao</span>
        <h1>Editar produto</h1>
        <p>Atualize as informacoes e salve no banco.</p>
    </section>

    <section class="panel">
        <form action="/produtos/<%= produto.id %>" method="post" class="edit-form">
            <label>
                Nome
                <input name="nome" value="<%= produto.nome %>" required>
            </label>
            <label>
                Valor
                <input name="valor" type="number" min="0" step="0.01" value="<%= produto.valor %>" required>
            </label>
            <label>
                Estoque
                <input name="estoque" type="number" min="0" step="1" value="<%= produto.estoque %>" required>
            </label>
            <label>
                Categoria
                <select name="categoria_id" required>
                    <% categorias.forEach((categoria) => { %>
                        <option value="<%= categoria.id %>" <%= Number(categoria.id) === Number(produto.categoria_id) ? 'selected' : '' %>>
                            <%= categoria.nome %>
                        </option>
                    <% }) %>
                </select>
            </label>

            <div class="actions">
                <button type="submit">Salvar</button>
                <a class="button ghost" href="/produtos">Cancelar</a>
            </div>
        </form>
    </section>
</main>

<%- include ('partials/footer') %>
