<%- include('partials/header') %>
<main class="shell narrow">
    <a class="back" href="/">← Voltar para eventos</a>
    <article class="detail-card">
        <span class="status <%= evento.vagas_disponiveis > 0 ? 'open' : 'full' %>"><%= evento.vagas_disponiveis > 0 ? 'Inscricoes abertas' : 'Lotado' %></span>
        <h1><%= evento.titulo %></h1><p class="lead"><%= evento.descricao %></p>
        <div class="detail-grid"><div><span>Data</span><strong><%= new Date(evento.data_evento).toLocaleString('pt-BR') %></strong></div><div><span>Local</span><strong><%= evento.local %></strong></div><div><span>Organizacao</span><strong><%= evento.organizador %></strong></div><div><span>Ocupacao</span><strong><%= evento.inscritos %> de <%= evento.vagas %> vagas</strong><progress value="<%= evento.inscritos %>" max="<%= evento.vagas %>" aria-label="<%= evento.inscritos %> de <%= evento.vagas %> vagas ocupadas"></progress></div></div>
        <% if (sucesso) { %><p class="alert success"><%= sucesso %></p><% } %><% if (error) { %><p class="alert error"><%= error %></p><% } %>
        <div class="actions"><% if (usuario?.papel === 'participante' && evento.vagas_disponiveis > 0) { %><form action="/eventos/<%= evento.id %>/inscricoes" method="post"><button type="submit">Confirmar inscricao</button></form><% } %><% if (usuario?.papel === 'organizador' && Number(usuario.id) === Number(evento.organizador_id)) { %><a class="button" href="/eventos/<%= evento.id %>/editar">Editar</a><form action="/eventos/<%= evento.id %>/excluir" method="post" onsubmit="return confirm('Excluir este evento?')"><button class="danger" type="submit">Excluir</button></form><% } %><% if (!usuario) { %><a class="button" href="/login">Entre para participar</a><% } %></div>
    </article>
</main>
<%- include('partials/footer') %>
