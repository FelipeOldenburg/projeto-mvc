<%- include('partials/header') %>
<main class="auth-shell"><section class="auth-card"><span class="eyebrow">Comece agora</span><h1>Crie sua conta</h1><p>Escolha seu perfil para acessar as funcoes certas.</p><% if (error) { %><p class="alert error"><%= error %></p><% } %><form action="/cadastro" method="post" class="stack"><label>Nome<input name="nome" autocomplete="name" required></label><label>E-mail<input name="email" type="email" autocomplete="email" required></label><label>Senha<input name="senha" type="password" minlength="6" autocomplete="new-password" required></label><label>Perfil<select name="papel" required><option value="participante">Participante</option><option value="organizador">Organizador</option></select></label><button type="submit">Criar conta</button></form><p class="form-note">Ja possui conta? <a href="/login">Entre aqui</a>.</p></section></main>
<%- include('partials/footer') %>
