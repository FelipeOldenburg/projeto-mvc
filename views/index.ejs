<%- include('partials/header') %>
<main class="shell">
    <section class="hero">
        <div><span class="eyebrow">Agenda inteligente</span><h1>Eventos que aproximam pessoas e ideias.</h1><p>Descubra encontros academicos e corporativos, acompanhe vagas e confirme sua participacao em poucos cliques.</p></div>
        <div class="hero-stat"><strong><%= eventos.length %></strong><span>eventos na agenda</span><% if (usuario?.papel === 'organizador') { %><a class="button" href="/eventos/novo">Criar evento</a><% } %></div>
    </section>
    <% if (sucesso) { %><p class="alert success"><%= sucesso %></p><% } %>
    <% if (error) { %><p class="alert error"><%= error %></p><% } %>
    <section class="section-head"><div><span class="eyebrow">Proximos encontros</span><h2>Eventos disponiveis</h2></div><span class="badge"><%= eventos.length %> cadastrados</span></section>
    <section class="event-grid">
        <% eventos.forEach((evento) => { %>
            <article class="event-card">
                <div class="event-date"><strong><%= new Date(evento.data_evento).toLocaleDateString('pt-BR', { day: '2-digit' }) %></strong><span><%= new Date(evento.data_evento).toLocaleDateString('pt-BR', { month: 'short' }) %></span></div>
                <div class="event-body"><span class="status <%= evento.vagas_disponiveis > 0 ? 'open' : 'full' %>"><%= evento.vagas_disponiveis > 0 ? 'Inscricoes abertas' : 'Lotado' %></span><h3><%= evento.titulo %></h3><p><%= evento.descricao %></p><dl><div><dt>Local</dt><dd><%= evento.local %></dd></div><div><dt>Vagas</dt><dd><%= evento.inscritos %>/<%= evento.vagas %></dd></div></dl><a class="button ghost" href="/eventos/<%= evento.id %>">Ver detalhes</a></div>
            </article>
        <% }) %>
        <% if (!eventos.length) { %><div class="empty"><h3>Nenhum evento publicado</h3><p>A agenda sera atualizada em breve.</p></div><% } %>
    </section>
</main>
<%- include('partials/footer') %>
