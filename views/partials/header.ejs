<!doctype html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/style.css">
    <title>EventHub</title>
</head>
<body>
<div class="particle-field" aria-hidden="true">
    <span class="particle"></span><span class="particle"></span><span class="particle"></span>
    <span class="particle"></span><span class="particle"></span><span class="particle"></span>
</div>
<header class="site-header">
    <div class="shell header-inner">
        <a class="brand" href="/"><span class="brand-mark">E</span><span><strong>EventHub</strong><small>Gestao de eventos</small></span></a>
        <nav aria-label="Navegacao principal">
            <a href="/">Eventos</a>
            <% if (usuario?.papel === 'organizador') { %><a href="/eventos/novo">Novo evento</a><% } %>
            <% if (usuario) { %>
                <span class="user-pill <%= usuario.papel %>"><%= usuario.nome %> · <%= usuario.papel %></span>
                <form action="/logout" method="post"><button class="link-button" type="submit">Sair</button></form>
            <% } else { %>
                <a href="/login">Entrar</a><a class="button compact" href="/cadastro">Criar conta</a>
            <% } %>
            <button class="motion-toggle" type="button" data-particle-toggle aria-pressed="false">Ativar luzes</button>
        </nav>
    </div>
</header>
<script>
    (() => {
        const key = 'eventhub-particle-motion';
        const toggle = document.querySelector('[data-particle-toggle]');
        let active = false;

        try {
            const choice = new URLSearchParams(window.location.search).get('motion');
            if (choice === 'on' || choice === 'off') localStorage.setItem(key, choice);
            active = localStorage.getItem(key) === 'on';
        } catch (_) {}

        const setMotion = (enabled) => {
            document.documentElement.toggleAttribute('data-particles-active', enabled);
            if (!toggle) return;
            toggle.setAttribute('aria-pressed', String(enabled));
            toggle.textContent = enabled ? 'Pausar luzes' : 'Ativar luzes';
        };

        setMotion(active);
        toggle?.addEventListener('click', () => {
            active = !active;
            try { localStorage.setItem(key, active ? 'on' : 'off'); } catch (_) {}
            setMotion(active);
        });
    })();
</script>
